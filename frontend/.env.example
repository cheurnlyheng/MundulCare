# Copy this file to .env.local and fill in your own values.

# Backend API base URL (defaults to http://localhost:8080/api if unset)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Google Sign-In: create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# with Authorized JavaScript origin http://localhost:3000, then paste the Client ID below.
# Leave blank to keep the Google button hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
