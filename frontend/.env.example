# Copy this file to .env.local and fill in your own values.

# Backend API base URL. Relative "/api" routes through the Next.js dev server's
# rewrite proxy (see next.config.ts) so the browser only ever talks to one origin
# (localhost:3000) and the backend's CORS config is no longer in the loop.
# If your backend runs somewhere other than http://localhost:8080, set BACKEND_URL
# instead (no need to change this line) - see next.config.ts.
NEXT_PUBLIC_API_URL=/api

# Google Sign-In: create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# with Authorized JavaScript origin http://localhost:3000, then paste the Client ID below.
# Leave blank to keep the Google button hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
