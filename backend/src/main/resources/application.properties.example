# Copy this file to application.properties (same folder) and fill in your own values.
# application.properties is gitignored so your secrets never get committed.

spring.application.name=hospitalAppointmentManagement

# Render (and most PaaS hosts) inject a PORT env var and route traffic to it - this must
# stay dynamic. Defaults to 8080 for local dev where no PORT is set.
server.port=${PORT:8080}

spring.datasource.url=jdbc:postgresql://localhost:5432/hospital
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=org.postgresql.Driver

# Flyway now owns schema changes (see src/main/resources/db/migration) instead of Hibernate
# guessing the DDL - ddl-auto=update previously failed more than once when adding a NOT
# NULL column to a table that already had rows. "validate" just checks entities match the
# schema on startup; it never alters anything. To change the schema going forward, add a
# new V2__description.sql migration file rather than changing this setting back.
spring.jpa.hibernate.ddl-auto=validate

# baseline-on-migrate lets Flyway adopt an existing database (like this project's dev DB,
# already at this exact schema from the old ddl-auto=update) without re-running V1 against
# it. On a brand-new empty database (e.g. a fresh production deploy), this has no effect -
# Flyway runs V1__baseline_schema.sql normally to create everything from scratch.
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# Email (Resend HTTP API - https://resend.com/api-keys) - sends over HTTPS, not SMTP,
# because Render (and many other hosts) blocks outbound SMTP on every port. Confirmed by
# testing both 587 and 465 directly against Render - both time out; only an HTTP-based
# provider actually gets through.
resend.api.key=your_resend_api_key
# onboarding@resend.dev is Resend's shared sandbox sender - works immediately with no setup,
# but only delivers to the Resend account's own email until you verify a custom domain there.
resend.from.email=MundulCare <onboarding@resend.dev>

# JWT Configuration - generate your own random secret, e.g. `openssl rand -hex 32`
jwt.secret=replace_with_a_long_random_secret
jwt.expiration=86400000

# Google Gemini API key: https://aistudio.google.com/apikey
gemini.api.key=your_gemini_api_key

# Profile / doctor photo uploads
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# Where uploaded photos are written on disk (served back out under /uploads/**).
# Defaults to a relative "uploads" folder for local dev. IMPORTANT: most hosting platforms
# have an ephemeral filesystem - anything written outside a persistent volume is wiped on
# every redeploy/restart. If your host provides one, point this at its mount path instead.
app.upload.dir=uploads

# Google Sign-In (create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# with Authorized JavaScript origin http://localhost:3000, then paste the Client ID below)
google.client.id=your_google_client_id.apps.googleusercontent.com

# CORS: comma-separated browser origins allowed to call this API directly (not needed for
# traffic through the Next.js rewrite proxy, since that's a server-to-server call - but
# still used by Swagger UI's "Try it out" and any other direct browser caller).
# In production, set this to your real deployed frontend URL(s), e.g.:
# app.cors.allowed-origins=https://your-frontend.example.com
app.cors.allowed-origins=http://localhost:3000
